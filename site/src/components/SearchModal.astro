<dialog
  id="site-search-dialog"
  class="search-dialog"
  data-search-dialog
  data-managed-dialog
  data-pagefind-ignore
  closedby="any"
  aria-labelledby="site-search-title"
>
  <div class="search-dialog-shell">
    <div class="search-dialog-head">
      <label for="site-search-input" id="site-search-title" class="search-dialog-title">
        Search Build Tutorial
      </label>
      <button type="button" class="search-close-btn" data-search-close aria-label="Close search">
        Esc
      </button>
    </div>

    <div class="search-input-wrap">
      <span class="search-input-icon" aria-hidden="true">⌕</span>
      <input
        id="site-search-input"
        type="text"
        inputmode="search"
        role="combobox"
        aria-autocomplete="list"
        aria-expanded="false"
        aria-controls="site-search-results"
        class="search-input"
        data-search-input
        placeholder="Search stages, prompts, tools (e.g. SKiDL, silk_layout.json, /wayfinder, TP7)…"
        autocomplete="off"
        spellcheck="false"
      />
    </div>

    <p class="search-status" data-search-status aria-live="polite">
      Type to search across all 13 ENV / SKEW Build Tutorial pages.
    </p>

    <ul
      id="site-search-results"
      class="search-results"
      data-search-results
      role="listbox"
      aria-label="Search results"
    ></ul>
  </div>
</dialog>
